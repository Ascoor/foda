# Optionally provide a fully-qualified API URL. Leave blank to compose from the
# base, prefix, and version variables below.
VITE_API_URL=

# Base API host exposed by the backend (no trailing slash).
VITE_API_BASE_URL=http://127.0.0.1:8000

# API route prefix and version configured in Laravel's RouteServiceProvider.
VITE_API_PREFIX=api
VITE_API_VERSION=v1
VITE_PUSHER_APP_KEY=local
VITE_PUSHER_APP_CLUSTER=mt1
VITE_PUSHER_HOST=127.0.0.1
VITE_PUSHER_PORT=6001
VITE_PUSHER_FORCE_TLS=false
