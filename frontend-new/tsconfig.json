{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "types": ["./types/vite-client"],
    "paths": {
      "@/*": ["./src/*"],
      "@app/*": ["./src/app/*"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@theme/*": ["./src/theme/*"],
      "@i18n/*": ["./src/i18n/*"]
    }
  },
  "include": [
    "src",
    "./*.ts",
    "./*.tsx",
    "./components/**/*.ts",
    "./components/**/*.tsx",
    "./layouts/**/*.ts",
    "./layouts/**/*.tsx",
    "./utils/**/*.ts",
    "./utils/**/*.tsx",
    "vite.config.ts",
    "tsconfig.node.json"
  ]
}
